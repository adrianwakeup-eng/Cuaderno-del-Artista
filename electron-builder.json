{
  "appId": "com.cuadernodelartista.crochet",
  "productName": "Cuaderno del Artista",
  "asar": true,
  "asarUnpack": [
    "electron/icon.ico",
    "electron/icon.png"
  ],
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*"
  ],
  "extraMetadata": {
    "main": "electron/main.cjs"
  },
  "win": {
    "icon": "electron/icon.ico",
    "target": [
      {
        "target": "portable",
        "arch": ["x64"]
      },
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "zip",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Cuaderno del Artista",
    "installerLanguages": ["es_ES"],
    "language": "1034",
    "artifactName": "Cuaderno-del-Artista-Windows-Instalador-${version}.exe"
  },
  "portable": {
    "artifactName": "Cuaderno-del-Artista-Windows-Portable-${version}.exe"
  },
  "mac": {
    "icon": "electron/icon.png",
    "category": "public.app-category.graphics-design",
    "identity": null,
    "target": [
      {
        "target": "zip",
        "arch": ["arm64", "x64"]
      }
    ],
    "artifactName": "Cuaderno-del-Artista-macOS-Portable-${version}-${arch}.${ext}"
  },
  "linux": {
    "icon": "electron/icon.png",
    "category": "Graphics",
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"]
      }
    ],
    "artifactName": "Cuaderno-del-Artista-Linux-Portable-${version}-${arch}.${ext}"
  }
}
