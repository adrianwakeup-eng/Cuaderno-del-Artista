{
  "appId": "com.cuadernodelartista.crochet",
  "productName": "Cuaderno del Artista",
  "asar": true,
  "asarUnpack": [
    "electron/icon.ico",
    "electron/icon.png"
  ],
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*"
  ],
  "extraMetadata": {
    "main": "electron/main.cjs"
  },
  "win": {
    "icon": "electron/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Cuaderno del Artista",
    "installerLanguages": ["es_ES"],
    "language": "1034",
    "artifactName": "Cuaderno-del-Artista-Instalador-${version}.exe"
  },
  "portable": {
    "artifactName": "Cuaderno-del-Artista-Portable-${version}.exe"
  }
}
